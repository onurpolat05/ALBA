{
  "permissions": {
    "allow": [
      "Read(memory/**)",
      "Read(.claude/**)",
      "Edit(memory/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Edit(**/*.env)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)"
    ]
  },

  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-start.sh", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/agent-suggest.sh", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/bash-validator.sh", "timeout": 5, "onFailure": "block"}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/error-logger.sh", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/memory-check.sh", "timeout": 5}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/session-end.sh", "timeout": 5}
        ]
      }
    ]
  }
}
